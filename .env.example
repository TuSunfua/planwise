# Copy to .env.local, which Git ignores. On Vercel, set these in the project's environment variables.
# "local" prints sign-in codes in the terminal, and only works with an http APP_URL. Never set it on Vercel.
APP_ENV=local
APP_URL=http://localhost:3000
# Local: the compose.yaml database. Vercel: Neon's pooled connection string.
DATABASE_URL=postgres://planwise:planwise@127.0.0.1:54329/planwise
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=
